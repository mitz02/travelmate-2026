# ─────────────────────────────────────────────────────────────────────────────
# TravelMate Frontend — .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment & Secrets (NEVER commit these) ────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.staging
.env.production
.env.test

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build Output ──────────────────────────────────────────────────────────────
dist/
dist-ssr/
build/
out/
.vite/
*.tsbuildinfo

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Test & Coverage ───────────────────────────────────────────────────────────
coverage/
.nyc_output/
test-results/
playwright-report/
cypress/videos/
cypress/screenshots/

# ── OS Generated ──────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini
ehthumbs.db

# ── Editor & IDE ──────────────────────────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~

# ── Vite / React specific ─────────────────────────────────────────────────────
storybook-static/
.storybook/public/

# ── Temporary / Cache ────────────────────────────────────────────────────────
.cache/
.temp/
.tmp/
tmp/
temp/

# ── Misc one-off scripts ──────────────────────────────────────────────────────
fix-backticks.cjs
