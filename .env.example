# Server
PORT=3000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT (use a strong secret in production)
JWT_SECRET=your-secret-key-change-in-production
# This secret is used to sign multi-step registration session tokens
REGISTRATION_SECRET=your-registration-secret-change-in-production

# Paystack
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key

# ─────────────────────────────────────────────────────────────────────────────
# Twilio SMS API
# Sign up at: https://www.twilio.com/
# ─────────────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890
# The base URL your API is reachable at (used in the email verification link)
APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# VTpass VTU API  (airtime, data, bills)
# Sign up at: https://www.vtpass.com/
# Sandbox dashboard: https://sandbox.vtpass.com/
# ─────────────────────────────────────────────────────────────────────────────
VTPASS_API_KEY=your-vtpass-api-key
VTPASS_SECRET_KEY=your-vtpass-secret-key
VTPASS_PUBLIC_KEY=your-vtpass-public-key
# Use sandbox URL for testing, switch to live for production:
# Sandbox: https://sandbox.vtpass.com/api
# Live:    https://vtpass.com/api
VTPASS_BASE_URL=https://sandbox.vtpass.com/api

# ─────────────────────────────────────────────────────────────────────────────
# Mapbox
# Sign up at: https://www.mapbox.com/
# ─────────────────────────────────────────────────────────────────────────────
MAPBOX_ACCESS_TOKEN=your-mapbox-access-token
