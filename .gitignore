# ─────────────────────────────────────────────────────────────────────────────
# TravelMate — .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment & Secrets (NEVER commit these) ────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.staging
.env.production
.env.test
*.pem
*.key
*.cert
*.p12
*.pfx
secrets/
credentials/

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ── Build Output ──────────────────────────────────────────────────────────────
dist/
build/
out/
.next/
.nuxt/
.vite/
*.tsbuildinfo

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Test / Check / Scratch files (project root one-offs) ─────────────────────
check_settings.ts
check_table.ts
test_agora.js
test_insert.ts
test_vtpass.ts
test_vtpass_direct.ts
test_vtpass_tv.ts
credit.ts
scratch/

# ── Coverage & Test Artifacts ─────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/
cypress/videos/
cypress/screenshots/

# ── OS Generated ──────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Editor & IDE ──────────────────────────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json
.vscode/*.code-snippets
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# ── TypeScript ────────────────────────────────────────────────────────────────
*.js.map
*.d.ts.map

# ── Package Manager Locks (keep only one) ────────────────────────────────────
# Uncomment the one you are NOT using:
# package-lock.json   # if using yarn
# yarn.lock           # if using npm

# ── Supabase Local Dev ────────────────────────────────────────────────────────
.supabase/
supabase/.branches/
supabase/.temp/

# ── Docker ────────────────────────────────────────────────────────────────────
.dockerenv
docker-compose.override.yml

# ── Temporary & Cache ─────────────────────────────────────────────────────────
.cache/
.temp/
.tmp/
tmp/
temp/
*.tmp
*.temp

# ── Firebase ──────────────────────────────────────────────────────────────────
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
firebase-service-account.json
google-services.json
GoogleService-Info.plist

# ── Uploads / User-generated files ───────────────────────────────────────────
uploads/
public/uploads/

# ── Misc ──────────────────────────────────────────────────────────────────────
*.zip
*.tar.gz
*.rar
dataplans.json
